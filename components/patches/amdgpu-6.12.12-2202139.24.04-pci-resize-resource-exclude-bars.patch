diff -ruN a/amd/dkms/m4/pci_resize_resource.m4 b/amd/dkms/m4/pci_resize_resource.m4
--- /dev/null
+++ b/amd/dkms/m4/pci_resize_resource.m4
@@ -0,0 +1,19 @@
+dnl #
+dnl # commit 337b1b566db087347194e4543ddfdfa5645275cc
+dnl # PCI: Fix restoring BARs on BAR resize rollback path
+dnl # pci_resize_resource() gained an exclude_bars argument; stable and
+dnl # distro kernels backported it.
+dnl #
+AC_DEFUN([AC_AMDGPU_PCI_RESIZE_RESOURCE], [
+	AC_KERNEL_DO_BACKGROUND([
+		AC_KERNEL_TRY_COMPILE([
+			#include <linux/pci.h>
+		], [
+			int r = pci_resize_resource(NULL, 0, 0, 0);
+			(void)r;
+		], [
+			AC_DEFINE(HAVE_PCI_RESIZE_RESOURCE_EXCLUDE_BARS, 1,
+				[pci_resize_resource() has an exclude_bars argument])
+		])
+	])
+])
