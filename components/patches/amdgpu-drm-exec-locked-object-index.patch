--- a/include/kcl/backport/kcl_drm_exec.h
+++ b/include/kcl/backport/kcl_drm_exec.h
@@ -5,6 +5,23 @@
 #include <drm/drm_exec.h>
 #include <kcl/kcl_drm_exec.h>
 
+/*
+ * Kernels with the drm/exec rework (upstream, backported to linux-azure
+ * 6.8.0-1073) dropped the index argument from
+ * drm_exec_for_each_locked_object[_reverse]() and added the internal
+ * __drm_exec_for_each_locked_object() helper. Restore the 3-argument form
+ * this driver uses.
+ */
+#ifdef __drm_exec_for_each_locked_object
+#undef drm_exec_for_each_locked_object
+#define drm_exec_for_each_locked_object(exec, index, obj)		\
+	for ((index) = 0; ((obj) = drm_exec_obj(exec, index)); ++(index))
+#undef drm_exec_for_each_locked_object_reverse
+#define drm_exec_for_each_locked_object_reverse(exec, index, obj)	\
+	for ((index) = (exec)->num_objects - 1;				\
+	     ((obj) = drm_exec_obj(exec, index)); --(index))
+#endif
+
 #ifndef HAVE_DRM_EXEC_INIT_3_ARGUMENTS
 static inline
 void _kcl_drm_exec_init(struct drm_exec *exec, uint32_t flags, unsigned nr)
