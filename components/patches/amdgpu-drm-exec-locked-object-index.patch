--- a/amd/dkms/m4/drm-exec.m4
+++ b/amd/dkms/m4/drm-exec.m4
@@ -15,6 +15,28 @@
         ])
 ])
 
+dnl #
+dnl # drm/exec: drm_exec_for_each_locked_object[_reverse]() dropped the
+dnl # index argument; stable and distro kernels (e.g. linux-azure
+dnl # 6.8.0-1073) backported it.
+dnl #
+AC_DEFUN([AC_AMDGPU_DRM_EXEC_FOR_EACH_LOCKED_OBJECT], [
+        AC_KERNEL_DO_BACKGROUND([
+                AC_KERNEL_TRY_COMPILE([
+                        #include <drm/drm_exec.h>
+                ], [
+                        struct drm_exec *exec = NULL;
+                        struct drm_gem_object *obj;
+
+                        drm_exec_for_each_locked_object(exec, obj)
+                                (void)obj;
+                ], [
+                        AC_DEFINE(HAVE_DRM_EXEC_FOR_EACH_LOCKED_OBJECT_2_ARGUMENTS, 1,
+                                [drm_exec_for_each_locked_object() has 2 arguments])
+                ])
+        ])
+])
+
 AC_DEFUN([AC_AMDGPU_DRM_EXEC], [
                 AC_AMDGPU_DRM_EXEC_INIT
 ])
