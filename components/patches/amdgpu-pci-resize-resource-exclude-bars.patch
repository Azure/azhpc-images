+				adev->pdev, 0, rbar_size,
+				(adev->asic_type >= CHIP_BONAIRE) ? 1 << 5 : 1 << 2),
+		int (*)(struct pci_dev *, int, int):
+			((int (*)(struct pci_dev *, int, int))(void (*)(void))pci_resize_resource)(
+				adev->pdev, 0, rbar_size));
 	if (r == -ENOSPC)
 		DRM_INFO("Not enough PCI address space for a large BAR.");
 	else if (r && r != -ENOTSUPP)
